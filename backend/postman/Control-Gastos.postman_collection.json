{
  "info": {
    "name": "Control de Gastos API",
    "description": "Colección completa para comprobar credenciales y tokens de Laravel Passport, seguridad Bearer y CRUD de categorías y gastos. Configure clientId y clientSecret en un Environment local de Postman antes de ejecutarla.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "clientId", "value": "" },
    { "key": "clientSecret", "value": "" },
    { "key": "token", "value": "" },
    { "key": "runEmail", "value": "" },
    { "key": "runPassword", "value": "password123" },
    { "key": "runSuffix", "value": "" },
    { "key": "categoriaId", "value": "" },
    { "key": "gastoId", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana López\",\n  \"email\": \"{{runEmail}}\",\n  \"password\": \"{{runPassword}}\",\n  \"password_confirmation\": \"{{runPassword}}\",\n  \"device_name\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runSuffix = Date.now().toString();",
                  "pm.collectionVariables.set('runSuffix', runSuffix);",
                  "pm.collectionVariables.set('runEmail', `ana.${runSuffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Registro devuelve 201 y token Passport', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.token).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{runEmail}}\",\n  \"password\": \"{{runPassword}}\",\n  \"device_name\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login devuelve 200 y token Passport', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.token).to.be.a('string').and.not.empty;"
                ]
              }
            }
          ]
        },
        {
          "name": "Generar token OAuth",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
                { "key": "username", "value": "{{runEmail}}", "type": "text" },
                { "key": "password", "value": "{{runPassword}}", "type": "text" },
                { "key": "scope", "value": "", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/oauth/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OAuth devuelve access_token y refresh_token', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
                  "pm.expect(body.expires_in).to.be.a('number');",
                  "pm.collectionVariables.set('token', body.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Seguridad",
      "item": [
        {
          "name": "Rechazar petición sin token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/gastos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ruta protegida devuelve 401 sin Bearer token', () => pm.response.to.have.status(401));",
                  "pm.expect(pm.response.json().message).to.eql('Unauthenticated.');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba {{runSuffix}}\",\n  \"color\": \"#F97316\"\n}"
            },
            "url": "{{baseUrl}}/api/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Categoría creada con 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.be.a('number');",
                  "pm.collectionVariables.set('categoriaId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Categorías devuelve 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener categoría",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Categoría individual devuelve 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('categoriaId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar categoría",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Prueba actualizada {{runSuffix}}\",\n  \"color\": \"#2563EB\"\n}"
            },
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Categoría actualizada con 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().nombre).to.eql(`Prueba actualizada ${pm.collectionVariables.get('runSuffix')}`);",
                  "pm.expect(pm.response.json().color).to.eql('#2563EB');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gastos",
      "item": [
        {
          "name": "Crear gasto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoria_id\": {{categoriaId}},\n  \"descripcion\": \"Almuerzo\",\n  \"monto\": 45.50,\n  \"fecha_gasto\": \"2026-08-18\",\n  \"notas\": \"Prueba desde Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/gastos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gasto creado con 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.id).to.be.a('number');",
                  "pm.collectionVariables.set('gastoId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar mis gastos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/gastos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gastos devuelve 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener gasto",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/gastos/{{gastoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gasto individual devuelve 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('gastoId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar gasto",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Almuerzo actualizado\",\n  \"monto\": 50.25,\n  \"notas\": \"Actualizado desde Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/gastos/{{gastoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gasto actualizado con 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().descripcion).to.eql('Almuerzo actualizado');",
                  "pm.expect(Number(pm.response.json().monto)).to.eql(50.25);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/usuario"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Perfil devuelve 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('runEmail'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar gasto",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/gastos/{{gastoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Gasto eliminado con 204', () => pm.response.to.have.status(204));",
                  "pm.expect(pm.response.text()).to.eql('');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Limpieza",
      "item": [
        {
          "name": "Eliminar categoría",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Categoría eliminada con 204', () => pm.response.to.have.status(204));",
                  "pm.expect(pm.response.text()).to.eql('');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
