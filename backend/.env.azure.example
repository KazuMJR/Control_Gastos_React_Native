APP_NAME="Control de Gastos API"
APP_ENV=production
APP_KEY=base64:GENERA_UNA_CLAVE_PROPIA
APP_DEBUG=false
APP_URL=https://NOMBRE-DE-TU-APP.azurewebsites.net

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/home/data/database.sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Crea la cuenta y los datos de demostración de manera idempotente.
RUN_DEMO_SEEDER=true
